{
  // AirSonde-CRM - Cloudflare Workers 配置
  // fork 自 Wanew-CRM（AI云端获客）@ e2d0ad0；结构照抄上游，值换 AirSonde。
  // D1 database_id 见下方 d1_databases（airsonde_crm，建库时生成，真值勿改）。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "airsonde-crm",
  "main": "src/index.ts",
  "compatibility_date": "2025-07-01",
  "compatibility_flags": ["nodejs_compat"],

  // 后台前端静态资源（public/ 目录）
  // run_worker_first: Worker 先跑，让 auth 中间件也能保护静态页面
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // D1 数据库绑定
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "airsonde_crm",
      "database_id": "TBD-CREATED-IN-C1"
    }
  ],

  // 非机密变量（模型随时可改）。机密（OPENROUTER_API_KEY）：
  //   本地 → .dev.vars 文件；线上 → wrangler secret put OPENROUTER_API_KEY
  //
  // ⛔ C1 发信结构性锁死（不是"先不用"，是发不出）：
  //   RESEND_API_KEY / LARK_WEBHOOK / LARK_IMAP_PASS / SEARCH_API_KEY / OPENROUTER_API_KEY
  //   一律**不配** = fail-closed。飞书 webhook 绝不复用 Wanew 的，等 Joe 建新群再配。
  "vars": {
    // 该 OpenRouter 账号被美国厂商(Anthropic/OpenAI/Google)按区域 ToS 拒绝(403)，
    // 只能用中国厂商模型。打分=DeepSeek(便宜)，写信=Qwen 高阶(质量好)。（上游实测结论，沿用）
    "SCORE_MODEL": "deepseek/deepseek-chat",
    "EMAIL_MODEL": "qwen/qwen3.7-max",
    "SITE_URL": "https://airsonde.com",

    // 发信身份（⚠️ 全部待发信域单落地；候选 airsonde.net 待 Joe 确认注册）。
    // SENDER_EMAIL 仅剩 imap.ts 收信端 fallback（LARK_IMAP_USER 未配时才用）；
    // SENDER_NAME 仅 senderBrand 兜底。真实发件人 = send.ts pickSender（现为 airsonde.net 占位）。
    "SENDER_EMAIL": "",
    "SENDER_NAME": "AirSonde",
    // APP_URL：退订链接 base。⚠️ 占位值指向 Access 门后的 crm 域 —— 发信开通前**必须**
    //   换成公开可达 host（Access 挡退订链接 = 合规违规，见上游 #53 注释）。C1 零发信，无实害。
    "APP_URL": "https://crm.airsonde.com",
    // 上游的 API_HOST / PUBLIC_API_URL（公开 API 正门）**故意不配**：
    //   未配 = #53 公开分支不激活（landing/退订/webhook 无公开面），全部路径留在 Access 门后。
    //   AirSonde 开发信/落地页上线时再随发信域单一起配。
    // ADMIN_HOST/ADMIN_URL：团队后台自定义域名，受 Cloudflare Access 保护（每人邮箱登录）
    "ADMIN_HOST": "crm.airsonde.com",
    "ADMIN_URL": "https://crm.airsonde.com",

    // 自动找客户。搜索提供商=serper（serper.dev）。机密 SEARCH_API_KEY 不配 = discovery fail-closed。
    "SEARCH_PROVIDER": "serper",

    // 后台 Basic Auth 应急入口用户名（非机密）。密码 ADMIN_PASSWORD 不配 = 该入口 fail-closed。
    "ADMIN_USER": "airsonde",

    // 收回复：Lark IMAP。密码 LARK_IMAP_PASS 不配 = 收信 fail-closed。USER 待发信域单定。
    "LARK_IMAP_HOST": "imap.larksuite.com",
    "LARK_IMAP_PORT": "993",
    "LARK_IMAP_USER": ""
  },

  // Cron：沿用上游 24 班节奏（0 * * * *）。C1 无任何 key，所有出站动作 fail-closed，
  // cron 空转只做无副作用的内部整理；discovery 仍只在 0/6/12/18 判定（index.ts isDiscoveryRound）。
  "triggers": {
    "crons": ["0 * * * *"]
  },

  // 团队后台自定义域名（Cloudflare 自动建 DNS + 证书）。airsonde.com 在同一 CF 账号。
  // Access 应用 airsonde-crm（crm.airsonde.com）Joe 已建好，worker 绑域即生效。
  "routes": [
    { "pattern": "crm.airsonde.com", "custom_domain": true }
  ],

  // 可观测性：开日志留存（上游 2026-07-28 事故结论：历史日志不可查 = 出问题只能等复现）。
  "observability": { "enabled": true, "head_sampling_rate": 1 },

  // C1 锁死：不开 workers.dev（上游开着是为了退订链接公开可达 + Basic Auth 应急；
  // AirSonde 零在途邮件，无此需求。发信域单落地时再随公开正门一起评估）。
  "workers_dev": false
}
